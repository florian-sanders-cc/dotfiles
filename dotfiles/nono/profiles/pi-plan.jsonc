{
  "extends": [
    "default"
  ],
  "meta": {
    "name": "pi-plan",
    "version": "",
    "description": "pi plan mode: read-only project, full internet, writable pi state",
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [
      "nix_runtime",
      "git_config",
      "linux_temp_read"
    ],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    // allow = writable pi/browser state only. Everything else in the audit
    // was either redundant (subpaths of a parent grant), dead (/npm), a
    // symlink into the read-only nix store (writes fail regardless), or
    // needs read only — see `read` below.
    "allow": [
      // Core writable pi state: sessions/, git/, bin/, nix-extensions/,
      // auth.json, models-store.json. Covers agents/skills/extensions/prompts
      // subdirs and the keybindings/APPEND_SYSTEM symlinks — no separate
      // grants needed.
      "$HOME/.pi/agent",
      // chromium-under-Landlock: --user-data-dir, daemon session dir, and
      // tmp/ (Playwright TMPDIR repoint; --disable-dev-shm-usage sends
      // profile+shm here). Everything the browser chain needs.
      "$HOME/.local/state/playwright-cli",
      // Removed after audit (re-add if a rebuild+test cycle breaks something):
      //   "/dev/shm" — chromium avoids it via --disable-dev-shm-usage; all
      //   browser shm+profile land in playwright-cli/tmp (TMPDIR repoint).
      //   "/run/user/1000/" — docker.sock (= host root), keyring, gnupg,
      //   session bus; nothing in the chain needs it (pw-broker comm is a
      //   file queue, chromium uses the TMPDIR repoint). If ever re-added:
      //   scope to the exact socket file, not the dir.
      // nvim inside sandboxed agents. Tiny, harmless.
      "~/.local/state/nvim/shada"
    ],
    "read": [
      // Skills repo-path dep. Content is markdown (read → exec is enough).
      // Deliberately NOT in `allow` for plan mode: a writable skills dir is a
      // persistent prompt-injection vector (agent rewriting its own
      // instructions). In-place editing lives in pi-write instead.
      "~/.agents/skills",
      // nix eval-cache + config inspection in plan mode (write would be
      // perf-only; not granted).
      "~/.cache/nix",
      // ~/.pi/bin exec → subagent spawning.
      "~/.pi",
      // Profiles → store symlink; agents may run `nono profile show`.
      "~/.config/nono",
      // mise = node runtime for pi extensions (jiti), playwright-cli, rtk;
      // includes shims/. Parent grant covers installs/node and installs/npm
      // — no subpath entries needed.
      "~/.local/share/mise",
      // ms-playwright chromium binaries (chromium-1071, -1187). read → exec
      // suffices; installs happen outside the sandbox.
      "~/.cache/ms-playwright",
      // Generic cache read (top-level stays unreadable without this).
      "~/.cache"
    ],
    // Pragmatic low-risk write area. Top-level cache is still unreadable as
    // a side effect (verified: `ls ~/.cache` → EACCES in-session).
    "write": [
      "~/.cache"
    ],
    // Empty: keybindings.json and APPEND_SYSTEM.md are symlinks into the
    // read-only nix store — writes fail regardless of any grant. Editing
    // flow = this repo + rebuild.
    "allow_file": [],
    "read_file": [],
    "write_file": [],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [],
    "bypass_protection": [],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "diagnostics": {
    "suppress_system_services": []
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "none"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "interactive": false,
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
