{
  "extends": [
    "default"
  ],
  "meta": {
    "name": "pi-plan",
    "version": "",
    "description": "pi plan mode: read-only project, full internet, writable pi state",
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [
      "nix_runtime",
      "git_config",
      "linux_temp_read"
    ],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    // allow = writable pi/browser state only. Everything else in the audit
    // was either redundant (subpaths of a parent grant), dead (/npm), a
    // symlink into the read-only nix store (writes fail regardless), or
    // needs read only — see `read` below.
    "allow": [
      // Core writable pi state: sessions/, git/, bin/, nix-extensions/,
      // auth.json, models-store.json. REAL files/dirs only — the symlinked
      // agents/skills/extensions/prompts dirs and keybindings/APPEND_SYSTEM/
      // settings files resolve OUT of this tree (nix store → this repo's
      // dotfiles/pi), and Landlock grants bind to real inodes: a parent
      // grant does NOT follow symlinks. Those get their own entries in
      // `read`/`read_file` below.
      "$HOME/.pi/agent",
      // chromium-under-Landlock: --user-data-dir, daemon session dir, and
      // tmp/ (Playwright TMPDIR repoint; --disable-dev-shm-usage sends
      // profile+shm here). Everything the browser chain needs.
      "$HOME/.local/state/playwright-cli",
      // Removed after audit (re-add if a rebuild+test cycle breaks something):
      //   "/dev/shm" — chromium avoids it via --disable-dev-shm-usage; all
      //   browser shm+profile land in playwright-cli/tmp (TMPDIR repoint).
      //   "/run/user/1000/" — docker.sock (= host root), keyring, gnupg,
      //   session bus; nothing in the chain needs it (pw-broker comm is a
      //   file queue, chromium uses the TMPDIR repoint). If ever re-added:
      //   scope to the exact socket file, not the dir.
      // nvim inside sandboxed agents. Tiny, harmless.
      "~/.local/state/nvim/shada"
    ],
    "read": [
      // Skills repo-path dep. Content is markdown (read → exec is enough).
      // Deliberately NOT in `allow` for plan mode: a writable skills dir is a
      // persistent prompt-injection vector (agent rewriting its own
      // instructions). In-place editing lives in pi-write instead.
      "~/.agents/skills",
      // Symlinked pi state: each entry below is a symlink under ~/.pi/agent
      // → /nix/store/...-home-manager-files (itself → this repo's
      // dotfiles/pi). nono resolves grant paths at sandbox build, so these
      // are effectively grants on the realpaths. READ-only by design: a
      // writable skills/prompts dir is a persistent prompt-injection vector
      // (agent rewriting its own instructions) — in-place editing lives in
      // pi-write. Files must use read_file (nono rejects non-dirs in `read`).
      "~/.pi/agent/agents",
      "~/.pi/agent/skills",
      "~/.pi/agent/extensions",
      "~/.pi/agent/prompts",
      // nix eval-cache + config inspection in plan mode (write would be
      // perf-only; not granted).
      "~/.cache/nix",
      // ~/.pi/bin exec → subagent spawning.
      "~/.pi",
      // Profiles → store symlink; agents may run `nono profile show`. The
      // profiles/ symlink resolves to this repo's dotfiles/nono/profiles,
      // so the parent ~/.config/nono grant alone doesn't cover it.
      "~/.config/nono",
      "~/.config/nono/profiles",
      // mise = node runtime for pi extensions (jiti), playwright-cli, rtk;
      // includes shims/. Parent grant covers installs/node and installs/npm
      // — no subpath entries needed.
      "~/.local/share/mise",
      // ms-playwright chromium binaries (chromium-1071, -1187). read → exec
      // suffices; installs happen outside the sandbox.
      "~/.cache/ms-playwright",
      // Generic cache read (top-level stays unreadable without this).
      "~/.cache"
    ],
    // Pragmatic low-risk write area. Top-level cache is still unreadable as
    // a side effect (verified: `ls ~/.cache` → EACCES in-session).
    "write": [
      "~/.cache"
    ],
    // allow_file empty: the symlinked files below are granted read-only —
    // writes target repo realpaths via this repo + rebuild (or pi-write for
    // in-place edits). Without the read_file grants pi startup degrades:
    // settings.json unreadable → settings lost; APPEND_SYSTEM.md unreadable
    // → system-prompt append dropped (warning at startup); keybindings.json
    // unreadable → custom bindings lost. Same symlink mechanism as the
    // `read` entries above — realpaths outside $HOME/.pi/agent.
    "allow_file": [],
    "read_file": [
      "~/.pi/agent/APPEND_SYSTEM.md",
      "~/.pi/agent/settings.json",
      "~/.pi/agent/keybindings.json"
    ],
    "write_file": [],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [],
    "bypass_protection": [],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "diagnostics": {
    "suppress_system_services": []
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "none"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "interactive": false,
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
