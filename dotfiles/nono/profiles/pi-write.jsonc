{
  "$schema": "./nono-profile.schema.json",
  "extends": "default",
  "meta": {
    "name": "pi-write",
    "description": "pi write mode: read-write project, network limited to LLM providers only"
  },
  "groups": {
    "include": ["nix_runtime"]
  },
  "filesystem": {
    // Out-of-store symlinks under ~/.pi/agent and ~/.agents/skills resolve to
    // $HOME/.config/nixos-config/dotfiles/... . R+W so we can edit subagents,
    // skills, extensions, prompts, keybindings, and the system prompt in
    // place; the parent-grant form below covers all symlinked subdirs
    // (agents/ skills/ extensions/ prompts/) and files (keybindings.json,
    // APPEND_SYSTEM.md, settings.json) without enumerating them — the grant
    // is scoped to these dotfiles subtrees only; the rest of the nixos-config
    // repo (modules/, flake.nix, secrets, ...) is NOT touched by this profile
    // and stays gated by the per-invocation --allow "$PWD".
    "allow": [
      // Core writable pi state incl. symlinked agents/skills/extensions/
      // prompts — parent grant suffices, subpath entries are redundant.
      "$HOME/.pi/agent",
      // chromium-under-Landlock: --user-data-dir, daemon session dir, tmp/
      // (TMPDIR repoint; --disable-dev-shm-usage sends profile+shm here).
      "$HOME/.local/state/playwright-cli",
      // In-place skill editing lives here (plan mode grants read only —
      // writable skills = persistent prompt-injection vector).
      "$HOME/.agents/skills"
    ],
    // mise JS toolchain installs = nix-store-equivalent runtime (read → exec,
    // verified via /nix/store). pi-write has no general net, so the agent can't
    // `mise install` to grow this; other JS installs (pnpm/bun/deno) added when
    // a project needs them. Deliberately subpaths, not the parent — tighter
    // than pi-plan's ~/.local/share/mise grant.
    "read": [
      "~/.local/share/mise/installs/node",
      "~/.local/share/mise/installs/npm",
      // ms-playwright chromium binaries (chromium-1071, -1187). read → exec
      // suffices; installs happen outside the sandbox.
      "~/.cache/ms-playwright"
    ]
  },
  "network": {
    "block": false,
    "allow_domain": [
      "api.anthropic.com",
      "openrouter.ai",
      "opencode.ai",
      "api.scaleway.ai"
    ]
  }
}
